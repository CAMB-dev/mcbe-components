* text=auto eol=lf
*.woff2 binary
# Original source resources are verified as whole bytes, including line endings.
src/assets/emote-wheel/** -text
src/assets/document-viewer/** -text
src/assets/player-permissions/** -text
src/assets/portfolio/** -text
src/assets/invite/** -text
src/assets/mob-effect/** -text
src/assets/chat/** -text
src/assets/progress/** -text
tests/fixtures/chat-materials/** -text
tests/fixtures/chat-materials/*.json whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# This unchanged upstream JSON intentionally ends with a blank line.
src/assets/document-viewer/_global_variables.json whitespace=-blank-at-eof
src/assets/player-permissions/_global_variables.json whitespace=-blank-at-eof

# Frozen independent whole-plane Progress references retain source bytes.
tests/fixtures/progress-materials/** -text
tests/fixtures/progress-resource-materials/** -text

# Frozen upstream originals keep intentional trailing spaces and blank final lines.
tests/fixtures/progress-materials/ORIGINALS/** whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
tests/fixtures/progress-resource-materials/ORIGINALS/** whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol

# Independent file-transmission source and material references remain whole bytes.
tests/fixtures/file-transmission-materials/** -text
tests/fixtures/file-transmission-materials/** whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tests/fixtures/file-transmission-materials/ORIGINALS/** whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
