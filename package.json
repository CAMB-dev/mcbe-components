  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.demo.json --noEmit",
    "build": "npm run typecheck && tsup --dts-only && vite build --config vite.library.config.ts && node scripts/copy-assets.mjs && vite build",
    "pretest": "node scripts/fetch-references.mjs",
    "test": "playwright test",
    "test:pixels": "node scripts/fetch-references.mjs && playwright test --project=pixels",
    "test:texture-cache": "node --test tests/texture-loader-cache.node.test.mjs",
    "test:bitmap-resources": "node --test tests/bitmap-text-resources.node.test.mjs",
    "test:gui-layer-tga": "node --test tests/gui-layer-tga.node.test.mjs",
    "test:classic-fonts": "python -m unittest discover -s tests -p classic_font_preparation_test.py",
    "preview": "vite preview --host 127.0.0.1",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build",
    "test:mob-effect:node": "node --test tests/mob-effect.node.test.mjs",
    "test:credits:node": "node --test tests/credits-clock.node.test.mjs tests/credits-roll-ssr.node.test.mjs tests/credits-screen-model.node.test.mjs",
    "test:progress:node": "node --test tests/progress-model.node.test.mjs tests/progress-panels.node.test.mjs tests/progress-indicators.node.test.mjs tests/progress-packs.node.test.mjs tests/progress-cloud.node.test.mjs tests/progress-screen.node.test.mjs tests/progress-public-parts.node.test.mjs tests/progress-react-props.node.test.mjs",
    "verify:progress:browser": "node scripts/qualify-progress-browser.mjs",
    "test:file-transmission:node": "node --test tests/file-transmission.node.test.mjs",
    "verify:file-transmission:browser": "node scripts/qualify-file-transmission-browser.mjs",
    "test:external-server:node": "node --test tests/external-server.node.test.mjs",
    "verify:external-server:browser": "node scripts/qualify-external-server-browser.mjs",
    "test:ore-text-field:node": "node --test tests/ore-text-field.node.test.mjs",
    "test:ore-external-server:node": "node --test tests/ore-button.node.test.mjs tests/ore-screen-frame.node.test.mjs tests/ore-scroll-area.node.test.mjs tests/ore-external-server-form.node.test.mjs",
    "test:ore-modal:node": "node --test tests/ore-modal.node.test.mjs",
    "test:furnace:node": "node --test tests/recipe-book-core.node.test.mjs tests/furnace-recipe-book.node.test.mjs tests/furnace-screen.node.test.mjs"
  },
  "peerDependencies": {
    "react": ">=18.3.0 <20",
    "react-dom": ">=18.3.0 <20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "react",
    "typescript",
    "minecraft",
    "bedrock",
    "pixel",
    "ui",
    "components"
  ]
